# Wajib
APP_PASSWORD=ganti-dengan-sandi-kuat

# Disarankan: string acak panjang untuk menandatangani cookie sesi
# contoh membuat: openssl rand -hex 32
SESSION_SECRET=

# Bot Telegram (dari @BotFather)
TELEGRAM_BOT_TOKEN=

# String acak untuk memverifikasi header webhook (A-Z, a-z, 0-9, _ dan -)
TELEGRAM_WEBHOOK_SECRET=

# Batasi bot hanya untuk chat ID kamu (opsional tapi sangat disarankan)
# Pisahkan dengan koma untuk beberapa ID. Kirim /start untuk melihat chat ID.
TELEGRAM_ALLOWED_CHAT_ID=

# Token untuk membuka /setup?token=... (pendaftaran webhook sekali jalan)
SETUP_TOKEN=

# Zona waktu untuk menentukan "hari ini"
TZ=Asia/Jakarta

# Scan struk via bot Telegram (opsional). Tanpa key ini, foto struk hanya bisa
# dibaca lewat tombol "Scan struk" di dashboard (Tesseract.js, di perangkat).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
RECEIPT_DAILY_LIMIT=20
